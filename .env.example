# BOSON_API_KEY: Required for authenticating with Boson AI Higgs Realtime.
# Ephemeral client secrets are minted on the server-side proxy (/api/token)
# using this permanent key, which is NEVER exposed to the frontend.
BOSON_API_KEY="bai-your-boson-api-key"

# Optional: Path to a file containing the Boson API key
# BOSON_API_KEY_FILE="/path/to/key"

# Optional: Boson API base URL (defaults to https://api.boson.ai)
# BOSON_BASE_URL="https://api.boson.ai"

# GEMINI_API_KEY: Reserved for AI Studio runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
